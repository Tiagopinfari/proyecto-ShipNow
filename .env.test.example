# ============================================================================
# ShipNow API — Variables de Entorno para Testing (.env.test.example)
# ============================================================================
# Copiá este archivo a .env.test (o .env) antes de ejecutar "npm test".
# Nota: Si se ejecuta "npm test" en un entorno recién clonado sin .env ni .env.test,
# src/config/env.config.js cargará automáticamente esta plantilla para garantizar
# que la suite de tests sea 100% reproducible out-of-the-box.

PORT=3001
NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/shipnow_test
JWT_SECRET=test_jwt_secret_key_shipnow
SHIPPING_API_KEY=test_shipping_api_key_shipnow
EXTERNAL_SHIPPING_API_URL=https://api.shipping.shipnow.internal/v1/rates
LOG_LEVEL=debug
ENABLE_SWAGGER_IN_PROD=false
ENABLE_INTERNAL_ENDPOINTS_IN_PROD=false
