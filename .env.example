# ============================================================================
# ShipNow API — Variables de Entorno (.env.example)
# ============================================================================

# 1. Configuración del Servidor y Entorno (development | test | production)
PORT=3000
NODE_ENV=development

# 2. Base de Datos MongoDB (Desarrollo / Producción)
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# 3. Base de Datos MongoDB exclusiva para Testing (Mocha / Chai / Supertest)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/shipnow_test

# 4. Seguridad y Servicios Externos (Obligatorios, sin valores harcodeados en código)
JWT_SECRET=tu_clave_secreta_jwt
SHIPPING_API_KEY=tu_shipping_api_key
EXTERNAL_SHIPPING_API_URL=https://api.shipping.shipnow.internal/v1/rates

# 5. Logging y Monitoreo (fatal | error | warning | info | http | debug)
LOG_LEVEL=debug

# 6. Criterio de Endpoints Internos en Producción (Mocks, LoggerTest, Swagger)
# En development/test están activos por defecto. En production se desactivan
# automáticamente salvo que se habiliten explícitamente con 'true'.
ENABLE_SWAGGER_IN_PROD=false
ENABLE_INTERNAL_ENDPOINTS_IN_PROD=false
